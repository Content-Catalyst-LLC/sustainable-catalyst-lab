{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/carbon-mrv-protocol-validation-v1300.schema.json",
  "title": "Sustainable Catalyst Carbon & Nature MRV Protocol Validation v0.13.0",
  "type": "object",
  "required": ["ok", "schema", "protocol_id", "method_key", "structural_status", "documentation_status", "protocol_readiness", "ready_for_internal_review", "missing_core_fields", "missing_sections", "missing_references", "missing_method_inputs", "missing_method_evidence", "result_fingerprint"],
  "properties": {
    "ok": {"const": true},
    "schema": {"const": "sc-carbon-nature-mrv-protocol-validation/0.13.0"},
    "protocol_id": {"type": "string"},
    "method_key": {"type": "string"},
    "structural_status": {"enum": ["complete", "incomplete"]},
    "documentation_status": {"enum": ["ready", "incomplete"]},
    "protocol_readiness": {"enum": ["ready-for-internal-review", "draft-incomplete"]},
    "ready_for_internal_review": {"type": "boolean"},
    "missing_core_fields": {"type": "array", "items": {"type": "string"}},
    "missing_sections": {"type": "array", "items": {"type": "string"}},
    "missing_references": {"type": "array", "items": {"type": "string"}},
    "missing_method_inputs": {"type": "array", "items": {"type": "string"}},
    "missing_method_evidence": {"type": "array", "items": {"type": "string"}},
    "external_methodology_compliance": {"type": "null"},
    "verification_status": {"type": "null"},
    "credit_eligibility": {"type": "null"},
    "interpretation": {"type": "string"},
    "guardrails": {"type": "object"},
    "result_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
