{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/carbon-mrv-stratified-allocation-v1400.schema.json",
  "title": "Sustainable Catalyst Stratified Sampling Allocation v0.14.0",
  "type": "object",
  "required": ["schema", "allocation_method", "total_sample_size", "strata", "guardrails", "result_fingerprint"],
  "properties": {
    "schema": {"const": "sc-carbon-nature-stratified-allocation/0.14.0"},
    "allocation_method": {"enum": ["equal", "proportional", "neyman"]},
    "total_sample_size": {"type": "integer", "minimum": 1},
    "strata": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "guardrails": {"type": "object"},
    "result_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
