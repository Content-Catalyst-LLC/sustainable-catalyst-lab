{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sc-lab-scientific-dataset/0.75.0",
  "title":"Sustainable Catalyst Lab Scientific Dataset v0.75.0",
  "type":"object",
  "required":["schema","version","recordType","id","title","rowCount","columnCount","columns","rows","provenance","fingerprint"],
  "properties":{
    "schema":{"const":"sc-lab-scientific-dataset/0.75.0"},
    "version":{"const":"0.75.0"},
    "recordType":{"const":"scientific-dataset-v0750"},
    "id":{"type":"string","minLength":1,"maxLength":160},
    "title":{"type":"string","minLength":1,"maxLength":240},
    "description":{"type":"string","maxLength":1500},
    "rowCount":{"type":"integer","minimum":1,"maximum":5000},
    "columnCount":{"type":"integer","minimum":1,"maximum":200},
    "columns":{"type":"array","items":{"type":"object","required":["key","label","dataType","unit"],"properties":{"key":{"type":"string"},"label":{"type":"string"},"dataType":{"enum":["number","integer","string","boolean","datetime","category"]},"unit":{"type":"string"}},"additionalProperties":true}},
    "units":{"type":"object"},
    "rows":{"type":"array","minItems":1,"maxItems":5000,"items":{"type":"object"}},
    "provenance":{"type":"object"},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "arbitraryCode":{"const":false}
  },
  "additionalProperties":true
}
