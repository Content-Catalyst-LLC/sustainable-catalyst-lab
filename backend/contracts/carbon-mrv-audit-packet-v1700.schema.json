  "required": [
    "schema",
    "audit_packet_id",
    "status",
    "project_id",
    "report_id",
    "report_fingerprint",
    "component_index",
    "section_index",
    "artifacts",
    "unresolved_items",
    "external_audit_status",
    "external_verification_status",
    "packet_fingerprint",
    "guardrails"
  ],
  "title": "Sustainable Catalyst Carbon & Nature MRV Audit Packet v0.17.0",
  "type": "object"
}
