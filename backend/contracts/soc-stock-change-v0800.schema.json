{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/soc-stock-change-v0800.schema.json",
  "title": "Carbon & Nature v0.8.0 SOC Stock Change Result",
  "type": "object",
  "required": ["schema", "domain_version", "lab_release_version", "comparison_id", "spatial_unit_id", "baseline_at", "followup_at", "stock_change_Mg_C_ha", "annualized_stock_change_Mg_C_ha_yr", "depth_match", "guardrails", "result_fingerprint"],
  "properties": {
    "schema": {"const": "sc-carbon-nature-soc-stock-change/0.8.0"},
    "domain_version": {"const": "0.8.0"},
    "lab_release_version": {"const": "0.91.0"},
    "comparison_id": {"type": "string"},
    "spatial_unit_id": {"type": "string"},
    "baseline_at": {"type": "string"},
    "followup_at": {"type": "string"},
    "stock_change_Mg_C_ha": {"type": "number"},
    "annualized_stock_change_Mg_C_ha_yr": {"type": "number"},
    "relative_stock_change_percent": {"type": ["number", "null"]},
    "area_ha": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "stock_change_Mg_C_total": {"type": ["number", "null"]},
    "direction": {"enum": ["increase", "decrease", "no-arithmetic-change"]},
    "depth_match": {"type": "object", "required": ["policy", "matched", "intervals"]},
    "interpretation": {"type": "object"},
    "guardrails": {"type": "object"},
    "result_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
