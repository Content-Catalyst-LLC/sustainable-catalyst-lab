{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "chain": {
      "properties": {
        "entry_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "previous_entry_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "previous_entry_hash",
        "entry_hash"
      ],
      "type": "object"
    },
    "content_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_id": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "methodology_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requirement_keys": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "accepted-for-internal-review",
        "flagged",
        "rejected-for-internal-review"
      ]
    },
    "schema": {
      "const": "sc-carbon-nature-mrv-verification-evidence-entry/0.16.0"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "evidence_id",
    "evidence_type",
    "source_ref",
    "review_state",
    "content_fingerprint",
    "chain"
  ],
  "title": "Carbon MRV verification evidence entry v0.16.0",
  "type": "object"
}
