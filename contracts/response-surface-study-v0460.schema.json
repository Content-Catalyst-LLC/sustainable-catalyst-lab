{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/response-surface-study-v0460.schema.json",
  "title": "Sustainable Catalyst Response Surface Study v0.46.0",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "title",
    "model",
    "factors",
    "response"
  ],
  "properties": {
    "schema": {
      "const": "sc-lab-response-surface-study/0.46.0"
    },
    "version": {
      "const": "0.46.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "const": "full-second-order"
    },
    "factors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "low",
          "high",
          "center"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "center": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "response": {
      "type": "object",
      "required": [
        "symbol"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
