{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/reproducible-model-package-v0500.schema.json",
  "title": "Sustainable Catalyst Lab Reproducible Model Package v0.50.0",
  "type": "object",
  "required": ["schema", "version", "recordType", "id", "modelVersion", "project", "model", "dataset", "methods", "results", "figures", "environment", "provenance", "componentHashes", "packageHash"],
  "properties": {
    "schema": {"const": "sc-lab-reproducible-model-package/0.50.0"},
    "version": {"const": "0.50.0"},
    "recordType": {"const": "reproducible-model-package"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,179}$"},
    "modelVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "model": {"type": "object"},
    "dataset": {"type": "object"},
    "methods": {"type": "array"},
    "results": {"type": "array"},
    "figures": {"type": "array"},
    "environment": {"type": "object"},
    "provenance": {"type": "object"},
    "componentHashes": {"type": "object"},
    "packageHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
