      "minimum": 0,
      "type": "number"
    },
    "category": {
      "minLength": 1,
      "type": "string"
    },
    "co2e_kg": {
      "minimum": 0,
      "type": "number"
    },
    "direction": {
      "enum": [
        "emission",
        "removal"
