{
  "schema": "sc-lab-model-studio-policy/0.42.0",
  "version": "0.42.0",
  "purpose": "Define and safely execute declarative scientific equations while preserving model, data-binding, provenance, visualization, and cross-product handoff contracts.",
  "boundaries": {
    "arbitraryCode": false,
    "arbitraryFormulaExecution": false,
    "safeDeclarativeExpressionExecution": true,
    "attributes": false,
