{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sc-lab-scientific-evidence-grade/0.65.0",
  "title":"Scientific Evidence Grade v0.65.0",
  "type":"object",
  "required":["schema","claimId","evidenceGrade","consensusCandidate","reviewedSupportCount","reviewedContradictionCount","gradeHash"],
  "properties":{
    "schema":{"const":"sc-lab-scientific-evidence-grade/0.65.0"},
    "claimId":{"type":"string"},
    "claimHash":{"type":["string","null"]},
    "claimType":{"type":["string","null"]},
    "claimDecision":{"type":["string","null"]},
    "evidenceGrade":{"enum":["insufficient","limited","moderate","substantial","contested"]},
    "consensusCandidate":{"type":"string"},
    "reviewedSupportCount":{"type":"integer","minimum":0},
    "reviewedContradictionCount":{"type":"integer","minimum":0},
    "literatureSupportSourceIds":{"type":"array","items":{"type":"string"}},
    "literatureContradictionSourceIds":{"type":"array","items":{"type":"string"}},
    "replicationSourceIds":{"type":"array","items":{"type":"string"}},
    "nonReplicationSourceIds":{"type":"array","items":{"type":"string"}},
    "uncertaintyLimitationSourceIds":{"type":"array","items":{"type":"string"}},
    "unreviewedSourceIds":{"type":"array","items":{"type":"string"}},
    "cautionSourceIds":{"type":"array","items":{"type":"string"}},
    "excludedSourceIds":{"type":"array","items":{"type":"string"}},
    "unresolvedSourceIds":{"type":"array","items":{"type":"string"}},
    "reviewedSynthesisProtocolIds":{"type":"array","items":{"type":"string"}},
    "synthesisProtocolIds":{"type":"array","items":{"type":"string"}},
    "replicationConsistencyCount":{"type":"integer","minimum":0},
    "replicationDisagreementCount":{"type":"integer","minimum":0},
    "highHeterogeneity":{"type":"boolean"},
    "moderateHeterogeneity":{"type":"boolean"},
    "sourceCautionPresent":{"type":"boolean"},
    "humanClaimReviewRequired":{"const":true},
    "gradeHash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
