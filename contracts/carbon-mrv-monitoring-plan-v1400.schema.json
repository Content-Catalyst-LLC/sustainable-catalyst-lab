{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/carbon-mrv-monitoring-plan-v1400.schema.json",
  "title": "Sustainable Catalyst Carbon & Nature Monitoring Plan v0.14.0",
  "type": "object",
  "required": ["schema", "monitoring_plan_id", "plan_version", "status", "method_key", "campaigns", "sampling_design", "method_documentation_readiness", "guardrails", "plan_fingerprint"],
  "properties": {
    "schema": {"const": "sc-carbon-nature-monitoring-plan/0.14.0"},
    "monitoring_plan_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "plan_version": {"const": "1.0.0"},
    "status": {"enum": ["draft", "ready-for-internal-review"]},
    "project_id": {"type": ["string", "null"]},
    "protocol_id": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "objective": {"type": ["string", "null"]},
    "method_key": {"type": "string", "minLength": 1},
    "method_title": {"type": "string"},
    "library_methodology_key": {"type": "string"},
    "spatial_boundary_ref": {"type": ["string", "null"]},
    "campaigns": {"type": "array", "items": {"type": "object"}},
    "sampling_frame_ref": {"type": ["string", "null"]},
    "sample_unit": {"type": ["string", "null"]},
    "sampling_design": {"type": "object"},
    "available_inputs": {"type": "array", "items": {"type": "string"}},
    "available_evidence": {"type": "array", "items": {"type": "string"}},
    "methodology_refs": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "method_documentation_readiness": {"type": "object"},
    "interpretation": {"type": "string"},
    "guardrails": {"type": "object"},
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
