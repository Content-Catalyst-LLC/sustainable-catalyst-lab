{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/contracts/scientific-graph-v0420.schema.json",
  "title": "Sustainable Catalyst Scientific Graph",
  "type": "object",
  "required": ["schema", "version", "kind", "title", "series", "accessibility", "interaction", "exports"],
  "properties": {
    "schema": {"const": "sc-lab-scientific-graph/0.42.0"},
    "version": {"const": "0.42.0"},
    "kind": {"enum": ["line", "scatter", "line-scatter", "histogram", "horizontal-bars", "heatmap"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "xLabel": {"type": "string"},
    "yLabel": {"type": "string"},
    "series": {"type": "array"},
    "annotations": {"type": "array"},
    "accessibility": {"type": "object"},
    "interaction": {"type": "object"},
    "exports": {"type": "array", "items": {"enum": ["svg", "png", "csv", "json"]}},
    "graphHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
