  "title": "Sustainable Catalyst Lab Model Research Bundle v0.50.0",
  "type": "object",
  "required": ["schema", "version", "filename", "mimeType", "sizeBytes", "sha256", "contentBase64", "packageId", "packageHash", "fileCount"],
