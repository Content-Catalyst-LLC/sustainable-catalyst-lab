{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sustainablecatalyst.com/contracts/scientific-claim-review-v0620.schema.json",
  "title":"Sustainable Catalyst Lab Scientific Claim Review v0.62.0",
