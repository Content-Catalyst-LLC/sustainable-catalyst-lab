{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sustainable Catalyst Lab Scientific Workflow Composer v0.57.0",
  "type": "object",
  "required": ["schema", "version", "id", "title", "stages", "order", "workflowHash"],
  "properties": {
    "schema": {"const": "sc-lab-scientific-workflow-composer/0.57.0"},
    "version": {"const": "0.57.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "title": {"type": "string"},
    "projectId": {"type": "string"},
    "stages": {"type": "array", "minItems": 1, "maxItems": 24},
    "order": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "string"}},
    "workflowHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
