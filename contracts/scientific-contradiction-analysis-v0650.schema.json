{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sc-lab-scientific-contradiction-analysis/0.65.0",
  "title":"Scientific Contradiction Analysis v0.65.0",
  "type":"object",
  "required":["schema","claimId","state","factors","requiresQualifiedInterpretation","contradictionHash"],
  "properties":{
    "schema":{"const":"sc-lab-scientific-contradiction-analysis/0.65.0"},
    "claimId":{"type":"string"},
    "state":{"type":"string"},
    "factors":{"type":"array","items":{"type":"string"}},
    "contradictionSourceIds":{"type":"array","items":{"type":"string"}},
    "nonReplicationSourceIds":{"type":"array","items":{"type":"string"}},
    "replicationDisagreementCount":{"type":"integer","minimum":0},
    "highHeterogeneity":{"type":"boolean"},
    "requiresQualifiedInterpretation":{"type":"boolean"},
    "contradictionHash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
